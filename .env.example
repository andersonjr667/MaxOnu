PORT=3000
MONGODB_URI=your-mongodb-uri-here
JWT_SECRET=your-jwt-secret-here

# Countdown Timer (formato ISO 8601)
COUNTDOWN_DATE=2026-05-04T10:30:00-03:00
FRONTEND_URL=http://localhost:3000

# Two-Factor Authentication
TWOFACTOR_ISSUER=MaxOnu2026
TWOFACTOR_WINDOW=2

# Email Configuration (para envio de emails - configurar conforme necessário)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_FROM=your-email@gmail.com

# Newsletter Feature Toggle (true para ativar, false para desativar)
NEWSLETTER_ENABLED=true

# SMTP Configuration (para newsletter)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
APP_URL=http://localhost:3000

# Cloudinary (upload de imagens dos posts)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
